<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPageI" %>
<%@ Register Src="~/usercontrol/menu.ascx" TagName="Menu" TagPrefix="UC" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link type="text/css" rel="Stylesheet" href="<%: HomeCareVersion.CssPath("m.min.css") %>" />
    <link type="text/css" rel="Stylesheet" href="<%: HomeCareVersion.CssPath("jquery.mobile.icons.min.css") %>" />
    <link type="text/css" rel="Stylesheet" href="<%: HomeCareVersion.CssPath("jquery.mobile.structure-1.4.5.min.css") %>" />
    <link type="text/css" rel="Stylesheet" href="<%: HomeCareVersion.CssPath("estilos.css") %>" />
    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("jquery-2.1.4.min.js")%>"></script>
    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager runat="server" ID="SM" LoadScriptsBeforeUI="false"></asp:ScriptManager>
    <div>
        <div data-role="page" id="p">
            <div data-role="header">
                <a href="#PM" data-icon="gear" data-iconpos="notext" id="mmenu" class="mmenu" title="Opciones"></a>
		        <h1><asp:Label runat="server" ID="LT"></asp:Label></h1>
                <asp:HyperLink runat="server" ID="HMenu" NavigateUrl="#PMenu" style="background-color: transparent;" Text="Menu" data-icon="bars" data-iconpos="notext"></asp:HyperLink>
	        </div><!-- /header -->
            <div role="main" class="ui-content">
            <asp:ContentPlaceHolder id="c" runat="server"></asp:ContentPlaceHolder>
            </div>
            <div data-role="footer">
                <div style="text-align: right; font-size: 8px;">OrganizationExample15 © Demostración local<br />
                    Desarrollado por <a href="http://www.sdg.com.co" target="_blank">Software Developers Group LTDA</a><br />
                    Versión <asp:Label runat="server" ID="LV"></asp:Label>
                </div>
	        </div><!-- /footer -->
            <UC:Menu runat="server" ID="UMenu" />
            <div class="hide" data-role="panel" data-position-fixed="true" data-display="overlay" data-theme="a" data-position="left" id="PM"><asp:ContentPlaceHolder id="m" runat="server"></asp:ContentPlaceHolder></div>
        </div>
    </div>
    </form>
    <script type="text/javascript" src="<%= HomeCareVersion.JSPath("jquery.mobile-1.4.5.min.js")%>"></script>
    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("angular-1.4.8.min.js")%>"></script>
    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("angular-locale_es.js")%>"></script>
    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("jquery.updatepanel.js")%>"></script>
    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("main.js")%>"></script>
    <script type="text/javascript">
        $(function() {
            $.mobile.ajaxEnabled = false;
            document.addEventListener("deviceready", function () { }, false);
            $("#mmenu").toggle($("#PM").text().trim().length > 0);
            $("#PM,#PMenu").removeClass("hide");
        });
    </script>
    <asp:ContentPlaceHolder id="s" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
