<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery-1.7.2.min.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.cookie.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery-ui-1.8.13.custom.min.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.ui.autocomplete.selectFirst.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.ui.datepicker-es.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery-ui-numeric-min.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.updatepanel.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.timeentry.min.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.ui.timepicker.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/jquery.maskedinput-1.3.min.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/combo.js"></script>
    <script type="text/javascript" src="<%=ResolveUrl("~/")%>js/main.js"></script>
    <link href="css/ui-lightness/jquery-ui-1.8.13.custom.css" type="text/css" rel="Stylesheet" />
    <link href="css/ui-lightness/jquery-ui-numeric-min.css" type="text/css" rel="Stylesheet" />
    <link href="css/estilo.css" type="text/css" rel="stylesheet" />
    <link rel="shortcut icon" href="images/tema/favicon.ico" />
    <script type="text/javascript">
        var user_logged = false;
        var user_logging = true;
        $(function() {
            $("#tabs").tabs();
            $("#ctl00_lnkCambioClave").click(function() {
                $("#contrasena").dialog(
                    {
                        modal: true,
                        autoOpen: true,
                        width: 'auto',
                        open: function(event, ui) { setTimeout("$('#contrasena :input:first').focus();", 100); },
                        buttons: {
                            "Aceptar": function() {
                                $("#ctl00_BAceptar").click();
                            },
                            "Cancelar": function() {
                                $(this).dialog("close");
                            }
                        }
                    });
                $("#ctl00_BAceptar").hide();
                $("#contrasena").parent().appendTo(jQuery("#aspnetForm"));
                return false;
            });
            var imp = $("#<%= lnkImp.ClientID %>");
            if (imp.attr("r") == "1") {
                imp.attr("href", window.location + "&p=1").attr("target", "_blank");
            }
            // setInterval("$('#renewSession').attr('src', '" + $('#renewSession').attr('src') + "?par=' + Math.random())", 180000);

            $('#<%= UPDiagAux.ClientID %>').panelUpdated(function() {

                if ($("#ctl00_titulo_aux").attr("title").length > 0) {
                    $("#dialog_aux").dialog({
                        modal: true,
                        autoOpen: true,
                        width: 'auto',
                        title: $("#ctl00_titulo_aux").attr("title"),
                        buttons: {
                            "Aceptar": function() {
                                $(this).dialog("close");
                            }
                        }
                    });
                    $(".ui-dialog-buttonpane button").attr('onclick', "$('#dialog-message').dialog('close'); $('#dialog_aux').dialog('close'); ");
                }
            });

            $('#<%= UAlertas.ClientID %>').panelUpdated(function() {
                addDialog("#<%= PAlertas.ClientID %>", "#dAlertas", true);
            });
            
            addFunctionToStart(function() {

                if ($("#<%= LMensaje.ClientID %>").html().length > 0) {
                    $("#dialog-message").dialog({
                        modal: true,
                        width: 'auto',
                        buttons: {
                            "Aceptar": function() {
                                $(this).dialog("close");
                            }
                        }
                    });
                    $(".ui-dialog-buttonpane button").attr('onclick', "$('#dialog-message').dialog('close'); $('#dialog_aux').dialog('close'); ");
                }
            });
        });
    </script>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <div id="loading">Cargando ...</div>
    <form id="form1" runat="server" autocomplete="off" >
