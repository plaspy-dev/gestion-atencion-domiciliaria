              </tr>
            </table>
        </td>
        <td></td>
    </tr>
    </table>
    
    <asp:UpdatePanel ID="UPDiagAux" runat="server" RenderMode="Inline">
        <ContentTemplate>
            <div id="titulo_aux" style="display: none" runat="server"></div>
            <div id="dialog_aux">
                <asp:Literal ID="LAuxDiag" runat="server"></asp:Literal>
            </div>
        </ContentTemplate>
    </asp:UpdatePanel>
    <div id="contrasena" title="Cambiar contraseña" style="display: none;">
        <table>
            <tr>
                <td align="left">
                    Actual
                </td>
                <td align="left">
                    <asp:TextBox ID="TActual" TextMode="Password" runat="server"></asp:TextBox>
                </td>
                <td align="left">
                    <asp:Button ID="BAceptar" runat="server" Text="Aceptar" 
                        ValidationGroup="contrasena" onclick="BAceptar_Click" />
                </td>
            </tr>
            <tr>
                <td align="left">
                    Nueva
                </td>
                <td align="left">
                    <asp:TextBox ID="TNueva" TextMode="Password" runat="server"></asp:TextBox>
                </td>
                <td align="left">
                    <asp:RequiredFieldValidator ID="RequiredFieldValidator1" runat="server" 
                        ControlToValidate="TNueva" ErrorMessage="Por favor ingrese una contraseña." 
                        Display="Dynamic" SetFocusOnError="true" ValidationGroup="contrasena"></asp:RequiredFieldValidator>
                </td>
            </tr>
            <tr>
                <td align="left">
                    Confirmar
                </td>
                <td align="left">
                    <asp:TextBox ID="TConfirmar" TextMode="Password" runat="server"></asp:TextBox>
                </td>
                <td align="left">
                    <asp:CompareValidator ID="CompareValidator1" runat="server" 
                        ControlToValidate="TNueva" ControlToCompare="TConfirmar" 
                        ErrorMessage="Las nuevas contraseñas no coinciden." Display="Dynamic" 
                        SetFocusOnError="true" ValidationGroup="contrasena"></asp:CompareValidator>
                </td>
            </tr>
        </table>
    </div>
    <asp:UpdatePanel ID="UMensaje" runat="server" UpdateMode="Always">
        <ContentTemplate>
            <div id="dialog-message" title="Error" class="hide">
                <asp:Label ID="LMensaje" runat="server" Text=""></asp:Label>
            </div>
        </ContentTemplate>
    </asp:UpdatePanel>
    </form>
<!-- <img src="<%=ResolveUrl("~/")%>renewSes.aspx" alt="" name="renewSession" id="renewSession" style="display: none" /> -->
<script type="text/javascript">

    function getDialogButton(dialog_selector, button_name) {
        var buttons = $(dialog_selector + ' .ui-dialog-buttonpane button');
        for (var i = 0; i < buttons.length; ++i) {
            var jButton = $(buttons[i]);
            if (jButton.text() == button_name) {
                return jButton;
            }
        }

        return null;
    }
    
    var g_OpenDialog = null;

    prm = Sys.WebForms.PageRequestManager.getInstance();
    prm.add_beginRequest(function(sender, args) {
        if (g_OpenDialog) {
            $(g_OpenDialog).dialog("close");
            g_OpenDialog = null;
        }
        $("#loading").show();
    });

    prm.add_pageLoaded(function(sender, args) {

        inicio();
        $("#loading").hide();
    });

    // reemplazamos la funcion de validacion de ASP
    function ValidatorOnChange(event) {
        if (!event) {
            event = window.event;
        }
        Page_InvalidControlToBeFocused = null;
        var targetedControl;
        if (event) {
            if ((typeof (event.srcElement) != "undefined") && (event.srcElement != null)) {
                targetedControl = event.srcElement;
            }
            else {
                targetedControl = event.target;
            }
        }
        var vals;
        if (typeof (targetedControl) != "undefined") { // omitimos este
            if (typeof (targetedControl.Validators) != "undefined") {
                vals = targetedControl.Validators;
            } else {
                if (targetedControl.tagName.toLowerCase() == "label") {
                    targetedControl = document.getElementById(targetedControl.htmlFor);
                    vals = targetedControl.Validators;
                }
            }
        }
        var i;
        if (vals) {
            for (i = 0; i < vals.length; i++) {
                ValidatorValidate(vals[i], null, event);
            }
        }
        ValidatorUpdateIsValid();
    }
</script>
</body>
</html>
