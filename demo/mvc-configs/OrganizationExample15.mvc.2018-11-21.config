<?xml version='1.0' encoding='utf-8'?>
<configuration xmlns:ns0="urn:schemas-microsoft-com:asm.v1"><configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <system.web>
    <httpRuntime executionTimeout="240" maxRequestLength="20480" requestValidationMode="2.0" targetFramework="4.6" />
    <compilation debug="true" targetFramework="4.6" />
    <authentication mode="Forms">
      <forms loginUrl="~/Index" slidingExpiration="true" defaultUrl="~/Inicio" timeout="86400" path="/" protection="All" />
    </authentication>
    <authorization>
      <allow users="*" />
      <deny users="?" />
    </authorization>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="System.Web.Optimization" />
        <add namespace="OrganizationExample15" />
      </namespaces>
      <controls>
        <add tagPrefix="sdg" namespace="SDG.Web.UI.WebControls" assembly="SDG.Componentes" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
<runtime>
    <ns0:assemblyBinding>
			<ns0:dependentAssembly>
				<ns0:assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30AD4FE6B2A6AEED" culture="neutral" />
				<ns0:bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="6.0.0.0" />
			</ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="System.Web.Optimization" publicKeyToken="31bf3856ad364e35" />
        <ns0:bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="1.1.0.0" />
      </ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <ns0:bindingRedirect oldVersion="0.0.0.0-1.5.2.14234" newVersion="1.5.2.14234" />
      </ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <ns0:bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="6.0.0.0" />
      </ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <ns0:bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <ns0:bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <ns0:bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </ns0:dependentAssembly>
      <ns0:dependentAssembly>
        <ns0:assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <ns0:bindingRedirect oldVersion="1.0.0.0-5.2.6.0" newVersion="5.2.6.0" />
      </ns0:dependentAssembly>
    </ns0:assemblyBinding>
  </runtime>
  </configuration>
