@using OrganizationExample15.Models
@model OrganizationExample15.Models.terapeutico.Cuentas
@{
    ViewBag.Title = "Cuentas";
    Layout = "~/Views/_Shared/_LayoutPage.cshtml";
    CUsuario usuario = ViewBag.User;
    bool showOK = (usuario.CanInsert() && string.IsNullOrEmpty(Model.ProtectedFields["id"])) || (usuario.CanUpdate() && !string.IsNullOrEmpty(Model.ProtectedFields["id"]));
}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-md-12">
            <div class="card card-accent-theme">
                <div class="card-body">
                    <form autocomplete="off" method="post" action="@(Request.Url.AbsolutePath + Request.Url.Query)">
                        @Html.AntiForgeryToken()
                        <table class="table table-sm table-striped">
                            <tr>
                                <td class="px">Funcionario</td>
                                <td class="px">@Html.Partial("~/Views/_Shared/Funcionario.cshtml", Model?.Funcionario, HomeCareVersion.GetPrefixPartial("Funcionario"))</td>
                                @if (!string.IsNullOrEmpty(Model.ProtectedFields["fid"]))
                                {
                                    <td class="px">Estado</td>
                                    <td class="w100">
                                        @if (usuario.CanAdmin())
                                        {
                                            @Html.DropDownListFor(x => x.Estado, Varios.Get(Varios.Tipo.EstadoCuenta).Select(x => new SelectListItem() { Text = x.Nombre, Value = x.Id }), "(Ninguno)", new { @class = "amc" })
                                        }
                                        else
                                        {
                                            @Varios.Get(Model.Estado?.ToString()).Nombre
                                        }
                                    </td>
                                }
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.ProtectedFields["fid"]))
                            {
                                <tr>
                                    <td>Desde @Html.ValidationMessageFor(x => x.Inicio, "*")</td>
                                    <td>@Html.TextBoxFor(x => x.Inicio, new { @class = "_date", id = "inicio" })</td>
                                    <td>Hasta @Html.ValidationMessageFor(x => x.Fin, "*")</td>
                                    <td>@Html.TextBoxFor(x => x.Fin, new { @class = "_date" })</td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="text-section-title"><h4>Servicios @Html.ValidationMessageFor(x => x._Servicios, "*")</h4></td>
                                </tr>
                                <tr>
                                    <td colspan="5" ng-controller="GridList as controller" ng-cloak>
                                        <table class="table table-sm table-striped table-bordered" ng-show="controller.list.length">
                                            <tr>
                                                <td></td>
                                                <td>Paciente</td>
                                                <td>Servicio</td>
                                                <td>Cantidad</td>
                                                <td>Total</td>
                                            </tr>
                                            <tr ng-repeat="row in controller.list">
                                                <td>
                                                    <a href="#" ng-click="controller.onDelete(row)" onclick="return false;" class="btn btn-xs btn-danger">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </td>
                                                <td class="w100 nw">{{row.pacienteIdLabel}}</td>
                                                <td class="nw">{{row.servicioIdLabel}}</td>
                                                <td class="r">{{row.cantidad}}</td>
                                                <td class="r">{{row.cantidad*row.valor | currency : "$" : 0 }}</td>
                                            </tr>
                                        </table>
                                        <div ng-hide="controller.list.length" class="card">
                                            <div class="card bg-light p-2">
                                                <p class="mb-0">Por favor agregue un servicio</p>
                                            </div>
                                        </div>
                                        <div class="r p-1">
                                            <div class="hide">
                                                @Html.TextBoxFor(x => x._Servicios, new { ng_model = "controller.result", ng_init = "controller.init('zServicios')", id = "zServicios", @class = "validate" })
                                                <input type="text" id="jsonlist" ng-model="controller.json" />
                                                <a href="#" id="listadd" ng-click="controller.onAdd()" onclick="return false;"></a>
                                            </div>
                                            <a href="#" class="btn btn-primary" onclick="return onAdd()"><i class="fa fa-plus"></i></a>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="text-section-title"><h4>Planilla de firmas @Html.ValidationMessageFor(x => x._Servicios, "*")</h4></td>
                                </tr>
                                <tr>
                                    <td colspan="5">
                                        @Html.Partial("~/Views/_Shared/Galeria.cshtml", Model?.Galeria, HomeCareVersion.GetPrefixPartial("Galeria"))
                                    </td>
                                </tr>
                            }
                        </table>
                        @if (!string.IsNullOrEmpty(Model.ProtectedFields["fid"]))
                        {
                            <div>@Html.ValidationSummary()</div>
                            <div class="r">
                                @if (showOK)
                                {
                                    @Html.HiddenFor(x => x._gk)
                                    <button type="submit" class="btn btn-submit">Aceptar</button>
                                }
                                <a href="@Request.Url.AbsolutePath" class="btn btn-default">Cancelar</a>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("CuentasServicio")

@section scripts {
    <link rel="stylesheet" href="~/lib/dropzone/dropzone.css" />
    <script type="text/javascript" src="~/lib/angular-1.7.2/angular.js"></script>
    <script src="~/js/angulargridctrl.js"></script>
    <script src="~/lib/dropzone/dropzone.js"></script>
    @if (!string.IsNullOrEmpty(Model.ProtectedFields["id"]))
    {
        <script>var __id = @Model.ProtectedFields["id"];</script>
    }
    <script>
        Dropzone.autoDiscover = false;
        var _mtercerooptions = {
            selectURL: docPath + "?fid="
        };
        function onAdd() {
            $("#mservicio").modal("show");
            return false;
        }

        function validateCantidad(value, element, form) {

            validateServicios($("#zServicios").val());
            var services = pacs.l;
            var paciente = $.validator._getFormElement(form, element, "PacienteId").val();
            var servicio = $.validator._getFormElement(form, element, "ServicioId").val();

            var info = services.find(function (x) { return x.pacienteId == paciente && x.servicioId == servicio });

            return info != null && +value <= info._cantidad;
        }

        function validateServiciosCount(value, element, form) {

            var list = [];
            try {
                list = JSON.parse(value);
            } catch (e) {
                return false;
            }
            return list.length > 0;
        }

        function validateServicios(value, element, form) {

            try {
                var list = [];
                list = JSON.parse(value);
                var services = pacs.l;
                for (var i = 0; i < services.length; i++) {
                    services[i]._cantidad = services[i].cantidad;
                }
                for (var i = 0; i < list.length; i++) {
                    var item = list[i];
                    var info = services.find(function (x) { return x.pacienteId == item.pacienteId && x.servicioId == item.servicioId });
                    if (!info || info._cantidad < item.cantidad)
                        return false;
                    info._cantidad -= item.cantidad;
                }
            } catch (e) {
                return false;
            }
            return true;
        }

        $(function () {
            Dropzone.autoDiscover = false;
            $("._mtercero").focus();
            $("#inicio").on("dp.change", function () {
                location.href = docPath + "?fid=" + $("._mhtercero").val() + "&ds=" + encodeURIComponent($(this).val());
            });
            var $form = $(".fakeform");
            $form.on("submit", function (e) {
                if (!$(this).valid()) {
                    return false;
                }
                var values = getFormValues(this);

                $("#jsonlist").val(JSON.stringify(values)).change();
                $("#listadd").click();
                $(this).find(".modal").modal("hide");
                $(window).resize();
                resetForm(this);
                return false;
            });

            var $pacientes = $form.find('[name="_Servicio.PacienteId"]');
            for (var i in pacs.p) {
                $pacientes.append('<option value="' + i + '">' + pacs.p[i] + '</option>');
            }
            var $info = $form.find("#serviceinfo");
            var $servicios = $form.find('[name="_Servicio.ServicioId"]');
            var $valor = $form.find('[name="_Servicio.Valor"]');
            $pacientes.change(function () {
                var paciente = $(this).val();
                $servicios.find("option").remove();
                $servicios.append('<option value="">(Ninguno)</option>');
                $info.html("");
                var servicios = pacs.l.filter(function (x) { return x.pacienteId == paciente; });
                for (var i = 0; i < servicios.length; i++) {
                    $servicios.append('<option value="' + servicios[i].servicioId + '">' + pacs.s[servicios[i].servicioId] + '</option>');
                }
            });
            $servicios.change(function () {
                var paciente = $pacientes.val();
                var servicio = $(this).val();
                var info = pacs.l.find(function (x) { return x.servicioId == servicio && x.pacienteId == paciente; });
                if (info && info.cantidad) {
                    validateServicios($("#zServicios").val());
                    $info.html(info._cantidad + " servicios por $" + info.valor.formatCurrency() + " ");
                    $valor.val(info.valor);
                } else {
                    $info.html("");
                    $valor.val("");
                }
            });

            if ($.getUrlParameter("er") == "1") {
                toastr.success("Cuenta editada");
            } else if ($.getUrlParameter("du") == "1") {
                toastr.success("Documentos actualizados");
            }
        });
    </script>
}
