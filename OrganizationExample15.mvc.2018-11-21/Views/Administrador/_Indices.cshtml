@model OrganizationExample15.Models.Administrador.MVarios
@{
    CUsuario user = ViewBag.User;
}
@using SDG.Componentes
@using OrganizationExample15.Models.Administrador
<div id="PP" style="display: none;" class="bkdlg modal fade" role="dialog">
    <form method="post" action="@Request.Url.AbsolutePath">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">@(MVarios.GetItem(Model.parametro1?.ToString()).Nombre ?? "Nuevo")</h4>
                    <a href="#" class="close" onclick="$('#PP').modal('hide'); return false;">&times;</a>
                </div>
                <div class="modal-body">
                    @Html.HiddenFor(x => x.Id)
                    @Html.HiddenFor(x => x._Tipo)
                    <table class="table table-condensed table-sm table-striped">
                        <tr>
                            <td>Grupo</td>
                            <td class="nw">
                                @Html.DropDownListFor(x => x.parametro1, MVarios.GetList((MVarios.Tipo)(Convert.ToInt32(Model.ProtectedFields["pid"]) - 1)).Select(x=>new SelectListItem() { Text= x.Nombre, Value= x.Id }), new { @class="amc" })
                                <a href="@Url.Content("~/Administrador/Parametros?t=" + (Convert.ToInt32(Model.ProtectedFields["pid"])-1))">Crear Grupo</a>
                            </td>
                        </tr>
                        <tr>
                            <td class="px">Nombre @Html.ValidationMessageFor(x => x.Nombre, "*")</td>
                            <td class="w100">@Html.TextBoxFor(x => x.Nombre, new { @class="w100" })</td>
                        </tr>
                        <tr>
                            <td class="nw">Calificación</td>
                            <td>@Html.TextBoxFor(x => x.Descripcion, new { @class = "entero", @type = "number" })</td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                @Html.ValidationSummary()
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    @if ((user.CanInsert() && string.IsNullOrEmpty(Model.Id)) || (user.CanUpdate() && !string.IsNullOrEmpty(Model.Id)))
                    {
                        @Html.HiddenFor(x => x._gk)
                        <input type="submit" value="Aceptar" class="btn btn-submit" />
                    }
                    <a href="#" onclick="$('#PP').modal('hide'); return false" class="btn btn-default">Cancelar</a>
                </div>
            </div>
        </div>
    </form>
    <script></script>
</div>

