@{
    ViewBag.Title = "Parámetros";
    Layout = "~/Views/_Shared/_LayoutPage.cshtml";
    CUsuario user = ViewBag.User;
    var list = Enum.GetValues(typeof(OrganizationExample15.Models.Administrador.Parametro2.Tipo)).Cast<OrganizationExample15.Models.Administrador.Parametro2.Tipo>()
        .Where(x => !string.IsNullOrEmpty(OrganizationExample15.Cache.GetEnumDescription<OrganizationExample15.Models.Administrador.Parametro2.Tipo>(x)))
        ;
    var headers= list
        .GroupBy(x=> OrganizationExample15.Cache.GetEnumDescription<OrganizationExample15.Models.Administrador.Parametro2.Tipo>(x).Split(new char[] { '/' })[0])
        .Select(x=>x.Key)
        .OrderBy(x=>x)
        ;
    string selectedParam = Request.QueryString["t"];
    if (string.IsNullOrEmpty(selectedParam))
    {
        selectedParam = "1";
    }
}
<div class="animated fadeIn">
    <div class="row">
        <div class="col-md-12">
            <div class="card card-accent-theme">
                <div class="card-body">
                    <table>
                        <tr>
                            <td class="vat">
                                <div class="card card-body navmenu navparameter" style="min-width: 300px">
                                    @{int i = 0; }
                                    @foreach (string parent in headers)
                                    {
                                        <div class="parent">
                                            <a href="#" data-toggle="collapse" data-target="@string.Format(".pchild{0}", ++i)" aria-expanded="false">@parent</a>
                                            @foreach (var item in list.Where(x => OrganizationExample15.Cache.GetEnumDescription<OrganizationExample15.Models.Administrador.Parametro2.Tipo>
                                                (x).StartsWith(parent)).OrderBy(x => OrganizationExample15.Cache.GetEnumDescription<OrganizationExample15.Models.Administrador.Parametro2.Tipo>
                                                    (x)))
                                                    {
                                                    <div class="child collapse @string.Format("pchild{0}", i)">
                                                        <a href="#" onclick="return changeParam(this)" data-param="@((int)item)" class="@(((int)item).ToString()==selectedParam ? "active" : null)">
                                                            @(OrganizationExample15.Cache.GetEnumDescription<OrganizationExample15.Models.Administrador.Parametro2.Tipo>(item).Split(new char[] { '/' })[1])
                                                        </a>
                                                    </div>
                                                    }
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="vat" style="min-width: 500px">
                                <table id="gpe" class="table table-sm table-bordered table-hover table-striped table-bootgrid">
                                    <thead>
                                        <tr>
                                            <th data-column-id="id" data-formatter="select" data-sortable="false" data-visible-in-selection="false"></th>
                                            @if (user.CanDelete())
                                            {
                                                <th data-column-id="id" data-formatter="delete" data-sortable="false" data-visible-in-selection="false"></th>
                                            }
                                            <th data-column-id="n" data-css-class="nw" data-header-css-class="w100" data-order="asc">Nombre</th>
                                        </tr>
                                    </thead>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <div class="dcplusbtn">
                        <div>
                            <a href="#" id="addg" onclick="return editRow();" class="btn btn-submit btn-circle btn-xl pull-right" style="padding-top: 18px; padding-left: 18px">
                                <i class="fa fa-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <!-- end card-body -->
            </div>
            <!-- end card -->
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->
</div>
@section scripts {
    <link rel="stylesheet" href="~/lib/jquery.bootgrid/jquery.bootgrid.css">
    <script src="~/lib/jquery.bootgrid/jquery.bootgrid.js"></script>
    <script src="~/lib/jquery.bootgrid/jquery.bootgrid.fa.js"></script>
    <script src="~/js/gridlistadd.js"></script>
    <script src="~/js/gridedit.js"></script>
    <style></style>
    <script>
        var _url = "@(Request.Url.AbsolutePath)";
        var url = "@(Request.Url.AbsolutePath + Request.Url.Query)";
        function changeParam(element) {
            var $element = $(element);
            var param = $element.data("param");

            url = _url + "?t=" + param;
            $(".navparameter").find(".active").removeClass("active");
            $element.addClass("active");
            startGrid();
            return false;
        }
        $(function () {
            var $selected = $(".navparameter").find(".active");
            changeParam($selected[0]);
            $selected.closest("div.parent").find("div").collapse("show");
        });
    </script>
}