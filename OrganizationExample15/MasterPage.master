    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("jquery.cookie.js") %>"></script>
    <script type="text/javascript" src="<%=HomeCareVersion.JSPath("jquery-ui-1.8.13.custom.min.js") %>"></script>
