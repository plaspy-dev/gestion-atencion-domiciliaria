<script type="text/javascript">

    function getDialogButton(dialog_selector, button_name) {
        var buttons = $(dialog_selector + ' .ui-dialog-buttonpane button');
        for (var i = 0; i < buttons.length; ++i) {
            var jButton = $(buttons[i]);
            if (jButton.text() == button_name) {
                return jButton;
            }
        }

        return null;
    }
    
    var g_OpenDialog = null;

    prm = Sys.WebForms.PageRequestManager.getInstance();
    prm.add_beginRequest(function(sender, args) {
        if (g_OpenDialog) {
            $(g_OpenDialog).dialog("close");
            g_OpenDialog = null;
        }
        $("#loading").show();
    });

    prm.add_pageLoaded(function(sender, args) {

        inicio();
        $("#loading").hide();
    });

    // reemplazamos la funcion de validacion de ASP
    function ValidatorOnChange(event) {
        if (!event) {
            event = window.event;
        }
        Page_InvalidControlToBeFocused = null;
        var targetedControl;
        if (event) {
            if ((typeof (event.srcElement) != "undefined") && (event.srcElement != null)) {
                targetedControl = event.srcElement;
            }
            else {
                targetedControl = event.target;
            }
        }
        var vals;
        if (typeof (targetedControl) != "undefined") { // omitimos este
            if (typeof (targetedControl.Validators) != "undefined") {
                vals = targetedControl.Validators;
            } else {
                if (targetedControl.tagName.toLowerCase() == "label") {
                    targetedControl = document.getElementById(targetedControl.htmlFor);
                    vals = targetedControl.Validators;
                }
            }
        }
        var i;
        if (vals) {
            for (i = 0; i < vals.length; i++) {
                ValidatorValidate(vals[i], null, event);
            }
        }
        ValidatorUpdateIsValid();
    }
</script>
<asp:Literal runat="server" ID="LMonoFix"></asp:Literal>
<script type="text/javascript" src="<%=HomeCareVersion.JSPath("FixFocus.js") %>"></script>
</body>
</html>
