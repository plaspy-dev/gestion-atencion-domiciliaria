    <link rel="shortcut icon" href="images/tema/favicon.ico" />
    <style type="text/css">
        #<%= headerm.ClientID %> {
            position: absolute; top: 1px; width: 100%;
        }
    </style>
    <script type="text/javascript">
        function onAlerta(id) {
            
            eval($(".ac" + id).attr("href"));
            return false;
        }
        var user_logged = false;
        var user_logging = true;
        $(function() {
            $("#tabs").tabs();

            var malertas = $("#malertas").menu().hide();

            $('#<%= lnkAlertas.ClientID %>').attr("target", "_blank").hover(function() {
                malertas.show().position({
                    my: "left top",
                    at: "left bottom",
                    of: this
                });

                // Register a click outside the menu to close it
                $(document).one("click", function() {
                    malertas.hide();
                });
            }).click(function() { return false; });

            $('#<%= UPDiagAux.ClientID %>').panelUpdated(function() {

                if ($("#ctl00_titulo_aux").attr("title").length > 0) {
                    $("#dialog_aux").dialog({
                        modal: true,
                        autoOpen: true,
                        width: 'auto',
                        title: $("#ctl00_titulo_aux").attr("title"),
                        buttons: {
                            "Aceptar": function() {
                                $(this).dialog("close");
                            }
                        }
                    });
                    $(".ui-dialog-buttonpane button").attr('onclick', "$('#dialog-message').dialog('close'); $('#dialog_aux').dialog('close'); ");
                }
            });

            function minValue(i, j) {
                return j > i ? i : j;
            }

            function maxValue(i, j) { 
                return i > j ? i : j;
            }

            var $header = $("#<%= headerm.ClientID %>");
            var $headerNext = $header.parent().next();
            var $headerParent = $header.parent();
            function updateHeader() {
                var rigthNext = $headerNext.width() + $headerNext.position().left;
                var maxAncho = maxValue($headerNext.position().left + $headerNext.width() - $headerParent.position().left - $headerParent.width() - 3, 0);
                ancho = minValue(rigthNext - $header.width(), $(window).width() + $(window).scrollLeft() - $headerParent.position().left - $headerParent.width());
                if (ancho > maxAncho)
                    ancho = maxAncho;
                if(ancho<1)
                    ancho = 1;
                $header.css({
                    'left': ancho
                });
            }
            $(window).scroll(updateHeader).resize(updateHeader);
            updateHeader();
            setTimeout(updateHeader, 1000);

            addFunctionToStart(function () {

                 var imp = $("#<%= lnkImp.ClientID %>");
                if (imp.attr("r") == "1") {
                    //  String().indexOf
                    var url = window.location;
                    if (window.location.href.indexOf('?') == -1)
                        url += "?";
                    else url += "&";
                    url+="p=1";
                    if (typeof(imp.attr("s"))=="string" && imp.attr("s") != "")
                        url += "&ss=" + imp.attr("s");
                    imp.attr("href", url).attr("target", "_blank");
                    imp.removeAttr("r");
                }

                setTimeout(updateHeader, 1000);
                if ($("#<%= LMensaje.ClientID %>").html().length > 0) {
                    $("#dialog-message").dialog({
                        modal: true,
                        width: 'auto',
                        buttons: {
                            "Aceptar": function() {
                                $(this).dialog("close");
                            }
                        }
                    });
                    $(".ui-dialog-buttonpane button").attr('onclick', "$('#dialog-message').dialog('close'); $('#dialog_aux').dialog('close'); ");
                }
            });
        });
    </script>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
