@using OrganizationExample15.Models.Shared
@model List<Property>
<div id="mld" class="mldp">
    @if (Model.Count == 0)
    {
        <div>No se encontraron modificaciones</div>
    }
    else
    {
        <table class="table table-sm table-bordered table-hover">
            @foreach (Property info in Model)
            {
                <tr>
                    <td class="w100 nw">@info.User</td>
                    <td class="r nw">@info.Date</td>
                </tr>
            }
        </table>
    }
</div>