@using OrganizationExample15.Models
@model OrganizationExample15.Models.terapeutico.Cuentas
@{
    ViewBag.Title = "Cuentas";
    Layout = "~/Views/_Shared/_LayoutPagePrint.cshtml";
    CUsuario usuario = ViewBag.User;
    Funcionario funcionario = @Funcionario.GetFuncionario(Model.Funcionario.Id);
}
<div class="pagina" style="margin: 2cm">
    Bogotá D.C., @DateTime.Parse(Model.Fin).ToLongDateString()
    <div class="r"><b>Cuenta de cobro @Model.ProtectedFields["id"]</b></div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <div class="c b">
        <h2>
            Gestión de atención domiciliaria S.A.S.<br />
            NIT: 000.000.015-0<br />
            DEBE A<br />
            @funcionario.Nombres<br />
            C.C.: @funcionario.Documento<br />
        </h2>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <div class="b">
        <table class="w100">
            <tr>
                <td class="nw">LA SUMA DE </td>
                <td class="w100" style="border-bottom: 1px dotted #000"></td>
                <td class="nw">@string.Format("{0:C0}", Model.Servicios.Sum(x => x.Cantidad*x.Valor))</td>
            </tr>
        </table>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <div>
        <b>POR CONCEPTO DE:</b>
        @foreach (var servicio in Model.Servicios)
        {
            <div><b>@servicio.Cantidad</b> servicios de <b>@servicio.ServicioIdLabel</b> a <b>@servicio.PacienteIdLabel</b></div>
        }
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    Cordialmente,
    <div class="w33" style="padding-top: 50px">
        <hr />
        @funcionario.Nombres<br />
        C.C.: @funcionario.Documento<br />
    </div>
</div>
<div class="c">
    <div style="border: 1px #AAA solid;border-radius: 5px; display: inline-block">
        <table class="l w100">
            <tr>
                <td colspan="2"><img src="~/imgs/logo170x62.jpg" /></td>
                <td class="nw c" colspan="2">
                    NIT: 000.000.015-0<br />
                    Dirección de demostración PBX: 000 000 0000<br />
                    Bogotá D.C., Colombia
                </td>
                <td colspan="2" class="c px nw">
                    FACTURA DE COMPRA AL<br />
                    REGIMEN SIMPLIFICADO
                    <div class="r b" style="margin-top: 5px; font-size: 25px">No. @Model.ProtectedFields["id"]</div>
                </td>
            </tr>
            <tr>
                <td colspan="6">
                    <hr />
                </td>
            </tr>
            <tr>
                <td class="b">Beneficiario</td>
                <td>@Funcionario.GetFuncionario(Model.Funcionario.Id).Nombres</td>
                <td class="b">C.C.</td>
                <td>@Funcionario.GetFuncionario(Model.Funcionario.Id).Documento</td>
                <td class="b">Fecha</td>
                <td>@Model.Fin</td>
            </tr>
            <tr>
                <td class="b">Dirección</td>
                <td>@funcionario.Direccion</td>
                <td class="b">Ciudad</td>
                <td>Bogotá</td>
                <td class="b">Teléfono</td>
                <td>@funcionario.Telefono</td>
            </tr>
        </table>
        <table class="l w100 tgrid">
            <tr>
                <th>Cantidad</th>
                <th colspan="3">Concepto</th>
                <th>Total</th>
            </tr>
                @foreach (var servicio in Model.Servicios)
                {
            <tr>
                <td class="r px">@servicio.Cantidad</td>
                <td class="nw" colspan="3">@servicio.ServicioIdLabel</td>
                <td class="r nw">@string.Format("{0:C0}", servicio.Cantidad*servicio.Valor)</td>
            </tr>
                }
            <tr style="background-color: white">
                <td colspan="2" style="min-width: 300px">
                    Benficiario
                    <br />
                    <br />
                    <br />
                    <hr style="margin: 0" />
                    C.C.
                </td>
                <td>
                    OrganizationExample15
                    <br />
                    <br />
                    <br />
                    <hr style="margin: 0" />
                    <div class="c">Autoriza</div>
                </td>
                <td class="px tdt">Total</td>
                <td class="r nw b tdt">@string.Format("{0:C0}", Model.Servicios.Sum(x => x.Cantidad * x.Valor))</td>
            </tr>
        </table>
    </div>
</div>
