@model OrganizationExample15.Models.terapeutico.Cuentas
<form class="fakeform">
    <div class="modal" tabindex="-1" role="dialog" id="mservicio">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Servicio</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-striped">
                        <tr>
                            <td class="px nw">Paciente @Html.ValidationMessageFor(x => x._Servicio.PacienteId, "*")</td>
                            <td class="w100">@Html.DropDownListFor(x => x._Servicio.PacienteId, new List<SelectListItem>(), "(Ninguno)", new { @class="amc" })</td>
                        </tr>
                        <tr>
                            <td>Servicio @Html.ValidationMessageFor(x => x._Servicio.ServicioId, "*")</td>
                            <td>@Html.DropDownListFor(x => x._Servicio.ServicioId, new List<SelectListItem>(), "(Ninguno)", new { @class = "amc" }) <span id="serviceinfo"></span></td>
                        </tr>
                        <tr>
                            <td class="nw">Cantidad @Html.ValidationMessageFor(x => x._Servicio.Cantidad, "*")</td>
                            <td>@Html.TextBoxFor(x => x._Servicio.Cantidad, new { @class="entero" })</td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.ValidationSummary()</td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer">
                    @Html.HiddenFor(x=>x._Servicio.Valor)
                    <button type="submit" class="btn btn-submit">Aceptar</button>
                    <a href="#" class="btn btn-default" data-dismiss="modal">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</form>
<script>
    var pacs= @Html.Raw(JsonConvert.SerializeObject(Model.GetPacientesServicio(), HomeCareVersion.JsonSerializerSettingsCamelCase));
</script>