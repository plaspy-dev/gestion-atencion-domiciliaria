<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Princ.master.vb" Inherits="ML.Princ" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <script type="text/javascript" src="../Util/Util.js"></script>
    </head>
<body >
    <form id="form1" runat="server"  >
    <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true">
    </asp:ScriptManager>
<table cellpadding="0" cellspacing="0" width="100%">
<tr><td align="center" >
<table cellpadding="0" cellspacing="0">
<tr><td align="left" >
            <asp:Panel ID="Panel1" runat="server" CssClass="roundedPanel" >
            <div style="width:700px; height:0px;"></div>
            <table cellpadding="0" cellspacing="0" id="tblPr"><tr><td style="width:auto;">
                <asp:Image ID="Image1" runat="server" SkinID="imgLogo" Width="150" Height="60"/>
                </td><td valign="bottom" align="left" style="width:40%;"><asp:Label ID="lblUsuario" runat="server" Text=""></asp:Label>
                    <br />
                    <asp:Label ID="lblNombre" runat="server" Text=""></asp:Label>
                </td>
                <td valign="bottom" align="right" >
                    <asp:LinkButton ID="lnkCambioClave" runat="server" 
                        PostBackUrl="~/formularios/CambioClave.aspx" CausesValidation="False">Cambio de Clave</asp:LinkButton>
                    &nbsp;&nbsp;
                </td><td valign="bottom" align="right" >
                    <asp:LinkButton ID="lnkSalir" runat="server" CausesValidation="False">Salir</asp:LinkButton>&nbsp;&nbsp;
                    </td>
                    </tr>
                    <tr>
                    <td colspan="4" >
                    <div class="celdaTitulo" >
                    <table width="100%"  cellpadding="0" cellspacing="0">
                    <tr><td>
                        <asp:Label ID="lblTitulo" skinId="lblTituloPagina" runat="server" Text="" ></asp:Label>
                    </td></tr>
                    <tr><td align="right">
                     <table><tr>
                     <td align="left" >
                         <asp:LinkButton ID="lnkEmail" runat="server" SkinID="lnkBarraHerr" 
                             Visible="False" CausesValidation="False" OnClientClick="email('dvContent');return false;">Correo</asp:LinkButton>
                     </td>
                     <td align="left" >
                         <asp:LinkButton ID="lnkImp" runat="server" SkinID="lnkBarraHerr" 
                             Visible="False" CausesValidation="False" OnClientClick="imprimir('dvContent');return false;">Imprimir</asp:LinkButton>
                     </td>
                     <td align="left" >
                         <asp:LinkButton ID="lnkGuardar" runat="server" SkinID="lnkBarraHerr" 
                             Visible="False" ValidationGroup="Guardar">Guardar</asp:LinkButton>
                     </td>
                     <td align="left" >
                         <asp:LinkButton ID="lnkExcel" runat="server" SkinID="lnkBarraHerr" 
                             Visible="False" CausesValidation="False">Excel</asp:LinkButton>
                         </td>
                     <td align="left" >
                         <asp:LinkButton ID="lnkVolver" runat="server" SkinID="lnkBarraHerr" 
                             Visible="False" CausesValidation="False">Volver</asp:LinkButton>
                         </td>
                     <td align="left" >
                         <asp:LinkButton ID="lnkNuevo" runat="server" SkinID="lnkBarraHerr" 
                             Visible="False" CausesValidation="False">Nuevo</asp:LinkButton>
                         </td><td >
                         <asp:LinkButton ID="LinkButton2" runat="server" SkinID="lnkBarraHerr" 
                                 CausesValidation="False" OnClientClick="location.href='Inicial.aspx';return false;">Inicio</asp:LinkButton>
                         </td></tr></table>
                    </td><td style="width:5px;"></td></tr>
                    </table>
                    </div> 
                    </td>
                    </tr>
                    <tr>
                    <td class="celdaMenu">
                        <asp:TreeView ID="TreeView1" runat="server" ImageSet="Arrows" 
                            EnableViewState="False">
                            <ParentNodeStyle Font-Bold="False" />
                            <HoverNodeStyle Font-Underline="True" ForeColor="#5555DD" />
                            <SelectedNodeStyle Font-Underline="True" ForeColor="#5555DD" 
                                HorizontalPadding="0px" VerticalPadding="0px" />
                            <NodeStyle Font-Names="Verdana" Font-Size="8pt" ForeColor="Black" 
                                HorizontalPadding="5px" NodeSpacing="0px" VerticalPadding="0px" />
                        </asp:TreeView>
                    </td>
                        <td colspan="3" valign="top" style="overflow:auto;border: thin solid #D4D4D4; width:80%;min-width:400px;">
                            <div runat="server" class='msj' id="dvMsj" visible="false"></div>
                            <div id="dvContent">
                                <asp:ContentPlaceHolder ID="cph" runat="server">
                                </asp:ContentPlaceHolder>
                            </div>
                        </td>
                        <td><div style="width:5px;"></div></td>
                </tr>
                    </table>
                            <div style="height:5px;"/>
                   
            </asp:Panel>
</td></tr>
</table>
</td></tr>
</table>

        <%--<asp:DropShadowExtender ID="dse" runat="server"
    TargetControlID="Panel1" 
    Opacity=".8" 
    Rounded="true"
    Radius="6"
    TrackPosition="true"/>--%>
        

    <p>
        &nbsp;</p>

     <asp:HiddenField runat="server" ID="hddDatoC" Value="0" />
    <div id="dvMensajes" runat="server" style="position:absolute;top:0;left:0" class="dvMensajes" visible="false">
    <table><tr><td><div runat="server" id="dvMensjesUs"></div></td><td style="width:5px;"></td></tr></table>
    </div>
    </form>
    
    <script type="text/javascript" language="javascript">
        var h = document.body.parentNode.clientheight;
        var h1 = screen.availHeight;
        h=(h>h1)?h:h1;
        document.write("<div id='<%=Me.ClientID+"_divManto"%>' style='display:none;'><div style='filter:alpha(opacity=60);left:0px;width:100%;position:absolute;top:0px;height:"+h+"px;background-color:white;opacity:.6;z-index:1000000000;'></div><div style='left:0px;width:100%;position:absolute;top:200px;z-index:100000000000;vertical-align:middle;font-weight:bold;color:Black;'><img src='../imgs/procesando.gif' style='height: 23px; width: 37px'/>Procesando... </div></div>");
    <%  If ValidarCambios() Then%>
        var validado=true;
        var validar = true;
        window.onbeforeunload = askConfirm;
        function DatoCambiado(){
            document.getElementById("<%=hddDatoC.clientId %>").value="1";
        }
        function askConfirm(){
            if(validar){
                if(validado){
                    if(document.getElementById("<%=hddDatoC.clientId %>").value=="1"){
                        validado=false;
                        setTimeout("validado=true;",100);
                        return "No ha guardado cambios.";
                    }
                }
            }
            else{
                if(validado){
                    validado=false;
                    setTimeout("validado=true;",100);
                }
            }
            validar=true;
        }
        function noPreguntar(){ 
            validar=false;
            setTimeout("validar=true;",100);
        }
    <%End If%>
        
    </script>
</body>
</html>
